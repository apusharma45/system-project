generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  PHARMACY
  DIAGNOSTIC
  ADMIN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CALLED
  IN_VISIT
  EXAM_DONE
  CLOSED
  CANCELLED
}

enum LabOrderStatus {
  CREATED
  ASSIGNED
  SAMPLE_COLLECTED
  RESULT_UPLOADED
  SENT
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  SENT_TO_PATIENT
  SENT_TO_PHARMACY
  DISPENSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientAppointments  Appointment[] @relation("PatientAppointments")
  doctorAppointments   Appointment[] @relation("DoctorAppointments")
  diagnosticLabOrders  LabOrder[]    @relation("DiagnosticLabOrders")
  doctorPrescriptions  Prescription[] @relation("DoctorPrescriptions")
  pharmacyPrescriptions Prescription[] @relation("PharmacyPrescriptions")
}

model Appointment {
  id String @id @default(uuid())

  patientId String
  patient   User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)

  doctorId String
  doctor   User   @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)

  status      AppointmentStatus @default(REQUESTED)
  scheduledAt DateTime
  requiresLab Boolean           @default(false)
  labFlowLocked Boolean         @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  labOrder    LabOrder?
  prescription Prescription?

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
}

model LabOrder {
  id String @id @default(uuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  diagnosticId String
  diagnostic   User @relation("DiagnosticLabOrders", fields: [diagnosticId], references: [id], onDelete: Restrict)

  status    LabOrderStatus @default(CREATED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  labResult LabResult?

  @@index([diagnosticId])
}

model LabResult {
  id String @id @default(uuid())

  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Restrict)

  fileUrl    String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([labOrderId])
}

model Prescription {
  id String @id @default(uuid())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  doctorId String
  doctor   User @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Restrict)

  pharmacyId String
  pharmacy   User @relation("PharmacyPrescriptions", fields: [pharmacyId], references: [id], onDelete: Restrict)

  notes  String
  status PrescriptionStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([pharmacyId])
}
